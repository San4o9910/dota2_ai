# Server-only secrets; do not commit the actual .env.
POSTGRES_PASSWORD=replace-with-a-random-password
# URL-encode special characters in the password.
DATABASE_URL=postgresql://narma:replace-with-a-random-password@db:5432/narma
VIDEO_SERVICE_TOKEN=replace-with-a-random-token-of-at-least-32-characters
GEMINI_API_KEY=
# Explicitly choose a currently supported image + structured-output model.
GEMINI_MODEL=
# Initial short-clip ceiling. Oversized videos fail before an API call; no sampling.
VIDEO_FRAME_BUDGET=3600
VIDEO_REQUEST_BUDGET=250
VIDEO_OWNER_DAILY_REQUEST_BUDGET=1000
# Server-created encryption key for the owner's ChatGPT OAuth tokens. Never commit a real value.
# Timeweb write_secrets.py generates this once; preserve it when restoring the database.
NARMA_CHATGPT_ENCRYPTION_KEY=
# Optional restriction; otherwise the existing single portal owner is required.
NARMA_CHATGPT_OWNER_ID=
NARMA_CHATGPT_MAX_DAILY_CALLS=6
# Explicit opt-in, no paid Gemini fallback while waiting for ChatGPT authorization.
REPLAY_COACH_PROVIDER=chatgpt_subscription
HERMES_PROVIDER=chatgpt_subscription
HERMES_RUNTIME_ENABLED=1
